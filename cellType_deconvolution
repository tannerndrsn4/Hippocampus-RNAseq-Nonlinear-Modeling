# Function to convert Ensembl gene IDs to gene names
convertEnsemblToGeneName <- function(ensemblIDs) {
  mart <- useMart(biomart = "ensembl", dataset = ensemblDataset, host = "www.ensembl.org")
  results <- getBM(attributes = c("ensembl_gene_id", "external_gene_name"), 
                   filters = "ensembl_gene_id", 
                   values = ensemblIDs, 
                   mart = mart)
  geneNames <- results$external_gene_name
  return(geneNames)
}

